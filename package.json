{
  "name": "paywarden",
  "version": "1.0.0-rc.2",
  "description": "Self-hosted TRC20 stablecoin payment gateway",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest",
    "test:unit": "vitest run --exclude src/__tests__/integration/**",
    "test:integration": "node scripts/test-integration.mjs",
    "test:report": "node scripts/test-report.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate:multi-merchant": "tsx --env-file=.env src/scripts/migrate-to-multi-merchant.ts",
    "smoke": "tsx src/scripts/smoke-test.ts"
  },
  "keywords": [
    "crypto",
    "payment",
    "trc20",
    "usdt",
    "tron"
  ],
  "author": "",
  "license": "BSL-1.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@noble/hashes": "^2.0.1",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bs58check": "^4.0.0",
    "bullmq": "^5.71.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.4",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tiny-secp256k1": "^2.2.4",
    "tronweb": "^6.2.2",
    "undici": "^7.24.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
