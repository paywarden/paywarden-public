# ============================================================================
# PayWarden — Production environment template
# ============================================================================
# Copy to .env.production and fill in real values before deploying.
# Generate all secrets with: openssl rand -hex 32
# ============================================================================

# ---------- Server ----------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------- Release ----------
# Build both images locally from the same source tag; see docs/deployment.md.
# See https://github.com/paywarden/paywarden-public/releases for available versions.
# The migrate image is a separate build target (see Dockerfile) — both images
# MUST share the same APP_IMAGE_TAG.
APP_IMAGE=paywarden
MIGRATE_IMAGE=paywarden-migrate
APP_IMAGE_TAG=v1.0.0-rc.2

# ---------- Caddy / TLS ----------
# Contact email for Let's Encrypt (required for cert issuance)
ACME_EMAIL=admin@paywarden.io

# ---------- PostgreSQL ----------
# Used by postgres service AND composed into DATABASE_URL below
POSTGRES_USER=paywarden
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=paywarden
DATABASE_URL=postgresql://paywarden:CHANGE_ME_STRONG_PASSWORD@postgres:5432/paywarden

# ---------- Redis ----------
# AOF persistence enabled in compose; password required
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379

# ---------- Security (MUST generate fresh) ----------
# openssl rand -hex 32
API_KEY=pw_REPLACE_WITH_64_HEX_CHARS
WEBHOOK_SECRET=whsec_REPLACE_WITH_64_HEX_CHARS
VAULT_KEY=REPLACE_WITH_64_HEX_CHARS
HMAC_SECRET=REPLACE_WITH_64_HEX_CHARS

# ---------- Admin Dashboard ----------
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS

# ---------- TRON ----------
# Get a free API key at https://www.trongrid.io (upgrade to paid for >100k req/day)
TRONGRID_API_KEY=your_trongrid_api_key
TRON_NETWORK=mainnet
# Mainnet USDT TRC20 contract
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ---------- Payment ----------
ORDER_TTL=1800
MIN_CONFIRMATIONS=19
SCAN_INTERVAL=3000
# "block" mode scales O(1) API calls regardless of concurrent orders — recommended for production
SCAN_MODE=block

# ---------- Fund Sweep ----------
# Leave HOT_WALLET_KEY and COLD_WALLET_ADDRESS empty to disable sweeping entirely.
# If set, funds from payment addresses are swept to COLD_WALLET_ADDRESS.
# HOT_WALLET_KEY=64_hex_chars_private_key_of_hot_wallet
# COLD_WALLET_ADDRESS=T...your_cold_wallet_address
SWEEP_MODE=burn
SWEEP_GAS_TOPUP_TRX=20
SWEEP_MIN_USDT=0.5
SWEEP_DELAY_MS=30000
HOT_WALLET_ALERT_TRX=50

# ---------- CORS ----------
# Same-origin deployment: all of /api, /admin, /checkout live under api.paywarden.io,
# so CORS can stay disabled. Only set this if you split the dashboard to a different host.
# CORS_ORIGIN=https://paywarden.io,https://admin.paywarden.io

# ---------- Reverse proxy ----------
# Set to true ONLY if the app is behind a trusted reverse proxy (Caddy/Nginx)
# that strips client-supplied X-Forwarded-For. The included
# docker-compose.prod.yml topology runs Caddy in front of the app on an
# internal Docker network, so set this to true for that deployment.
# Leaving it false is the safe default — if you expose the app directly
# without a proxy, true would let any client spoof their IP and bypass
# IP-based rate limits.
TRUST_PROXY=true

# ---------- Notifications — Telegram (optional) ----------
# Create a bot via @BotFather, then get your chat ID from @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---------- Notifications — Email / SMTP (optional) ----------
# Resend, SendGrid, Amazon SES, or any SMTP provider
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM=alerts@paywarden.io
# ALERT_EMAIL_TO=admin@paywarden.io
